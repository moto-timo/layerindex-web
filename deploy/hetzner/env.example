# layerindex-web production environment. Copy to the repo root as .env,
# fill in, and `chmod 600 .env`. Never commit the filled-in copy.
#
#   cp deploy/hetzner/env.example .env
#   python3 -c 'import secrets;print("SECRET_KEY="+secrets.token_urlsafe(64))'
#   openssl rand -base64 24    # for each password below
#
# SPDX-License-Identifier: MIT

# ---------------------------------------------------------------- hostname --
# Must already resolve (A, and AAAA only if IPv6 works end to end) to this box
# BEFORE you first start Caddy. Used for TLS, ALLOWED_HOSTS and CSRF origins.
LAYERINDEX_HOSTNAME=layers.example.com

# ------------------------------------------------------------------- caddy --
ACME_EMAIL=hostmaster@example.com
# Uncomment while testing. Browsers will show a cert warning; that is expected.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ------------------------------------------------------------------ django --
SECRET_KEY=

# ---------------------------------------------------------------- database --
DATABASE_ROOT_PASSWORD=
DATABASE_USER=layers
DATABASE_PASSWORD=
# Roughly 50-60% of RAM on a dedicated box; 2G is right for a 16 GB CX43.
MARIADB_BUFFER_POOL=2G

# ---------------------------------------------------------------- rabbitmq --
RABBITMQ_DEFAULT_USER=layers
RABBITMQ_DEFAULT_PASS=

# ------------------------------------------------------------------ celery --
# Each concurrent bitbake parse wants ~1-2 GB. 2 is safe on 16 GB.
CELERY_CONCURRENCY=2

# ------------------------------------------------------------------- email --
# Hetzner Cloud blocks outbound ports 25 and 465 by default; 587 is open.
# Unblocking 25 requires a limit request at https://console.hetzner.com/limits
# after your first paid invoice. Use a relay (SES/Postmark/Mailgun/your MX)
# instead -- deliverability from a fresh Hetzner IP is poor regardless.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=1

# ---------------------------------------------- phase 2: Authentik SSO -----
# Leave OIDC_RP_CLIENT_ID empty and none of this is loaded.
#AUTHENTIK_URL=https://sso.example.com
#AUTHENTIK_APP_SLUG=layerindex
#OIDC_RP_CLIENT_ID=
#OIDC_RP_CLIENT_SECRET=
# Comma-separated Authentik group names granting Django staff / superuser.
#OIDC_STAFF_GROUPS=layerindex-staff
#OIDC_SUPERUSER_GROUPS=layerindex-admins
# Set to 0 once SSO is authoritative to close local self-registration.
#REGISTRATION_OPEN=0
